{
  "name": "puppeteer-launching",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Private Cloudflare Worker for puppeteer-launching.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "wrangler dev",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test tests.js",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "@cloudflare/puppeteer": "^1.0.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261025.1",
    "@types/node": "24.5.2",
    "typescript": "5.9.2",
    "wrangler": "4.42.0"
  }
}