{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "puppeteer-launching",
  "main": "index.js",
  "compatibility_date": "2026-11-24",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "browser": {
    "binding": "BROWSER"
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": false,
      "head_sampling_rate": 1,
      "persist": true
    },
    "issue_detection": {
      "enabled": false
    }
  }
}
